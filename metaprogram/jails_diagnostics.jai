Plugin :: Metaprogram_Plugin;

Jails_Diagnostics_Plugin :: struct {
    #as using base: Plugin;
    intermediate_path: string;
    seen_types: int;   // how many struct types we've dumped
}

get_plugin :: () -> *Plugin {
    p := New(Jails_Diagnostics_Plugin);

    p.init = init;
    p.before_intercept = before_intercept;
    p.add_source = add_source;
    p.message = message;
    p.shutdown = shutdown;

    return p;
}

init :: (p: *Plugin, options: [] string) -> bool {
    my := cast(*Jails_Diagnostics_Plugin) p;

    cursor := 0;
    while cursor < options.count {
        s := options[cursor];
        if s == {
          case "-intermediate_path";
            if cursor >= options.count-1 {
                log_error("Jails_Diagnostics_Plugin: Missing argument to -intermediate_path.\n");
                return false;
            }

            my.intermediate_path = options[cursor+1];
            cursor += 2;
          case;
            log_error("Command line for plugin Jails_Diagnostics_Plugin: Unknown argument '%'\n", s);
            return false;
        }
    }

    return true;
}

// ── Struct type info dump ──────────────────────────────────────────────
// Hooks into typechecking to capture struct member info from the compiler,
// including members generated by #bake_arguments / #insert -> string.
// Output goes through compiler_report(.INFO) — captured by the LSP from stderr.
// Format: JAILS_DIAG_STRUCT|type_name|member_count|member1,member2,...

emit_decl_type :: (decl: *Code_Declaration) {
    if !decl return;

    type_id: u64;
    if decl.type {
        type_id = cast(u64) decl.type;
    }
    if decl.type_inst && decl.type_inst.result {
        type_id = cast(u64) decl.type_inst.result;
    }
    if decl.expression {
        if decl.expression.kind == .PROCEDURE_CALL {
            call := cast(*Code_Procedure_Call) decl.expression;
            if call.resolved_procedure_expression && call.resolved_procedure_expression.kind == .STRUCT {
                st := cast(*Code_Struct) call.resolved_procedure_expression;
                if st.defined_type type_id = cast(u64) st.defined_type;
            }
        } else if decl.expression.kind == .STRUCT {
            st := cast(*Code_Struct) decl.expression;
            if st.defined_type type_id = cast(u64) st.defined_type;
        } else if decl.expression.type {
            type_id = cast(u64) decl.expression.type;
        }
    }
    if type_id == 0 return;

    file := "";
    if decl.enclosing_load file = decl.enclosing_load.fully_pathed_filename;
    print("JAILS_DIAG_DECL_TYPE|%|%|%|%|%\n", decl.name, file, decl.l0, decl.c0, type_id);
}

message :: (_p: *Plugin, msg: *Message) {
    if msg.kind != .TYPECHECKED return;

    p := cast(*Jails_Diagnostics_Plugin) _p;
    tc := cast(*Message_Typechecked) msg;

    for s: tc.structs {
        cs := s.expression;
        if !cs.defined_type continue;
        si := cs.defined_type;

        // Skip structs with no members or internal compiler types
        if si.members.count == 0 continue;

        // Skip if name is empty (anonymous structs)
        if si.name.count == 0 continue;

        // Build member list string
        member_str := si.members[0].name;
        for member, i: si.members {
            if i == 0 continue;
            member_str = sprint("%,%", member_str, member.name);
        }

        // Report via print — captured by LSP's run_command stdout/stderr.
        // compiler_report(.INFO) is suppressed by -quiet, so use print instead.
        print("JAILS_DIAG_STRUCT|%|%|%\n", si.name, si.members.count, member_str);
        print("JAILS_DIAG_STRUCT_ID|%|%|%|%\n", cast(u64) si, si.name, si.members.count, member_str);
        p.seen_types += 1;
    }

    // Map source declarations to compiler type ids. This bridges parser AST nodes
    // to Type_Info ids emitted above using file+location+name.
    for d: tc.declarations {
        emit_decl_type(d.expression);
    }

    for pb: tc.procedure_bodies {
        for node: pb.subexpressions {
            if node.kind == .DECLARATION {
                emit_decl_type(cast(*Code_Declaration) node);
            }
        }
    }
}

add_source :: (_p: *Plugin) {
    p := cast(*Jails_Diagnostics_Plugin) _p;
    add_build_string("JAILS_DIAGNOSTICS_BUILD :: true;", p.workspace);
}

before_intercept :: (_p: *Plugin, flags: *Intercept_Flags) {
    p := cast(*Jails_Diagnostics_Plugin) _p;
    options := get_build_options(p.workspace);
    options.output_type = .NO_OUTPUT;

    if p.intermediate_path {
        options.intermediate_path = p.intermediate_path;
    }

    set_build_options(options, p.workspace);
}

shutdown :: (_p: *Plugin) {
    p := cast(*Jails_Diagnostics_Plugin) _p;
    log("Jails diagnostics: dumped % struct types", p.seen_types);
    free(p);
}

#import "Compiler";
#import "Basic";
#import "String";
